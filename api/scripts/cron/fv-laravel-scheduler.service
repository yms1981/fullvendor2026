[Unit]
Description=FullVendor Laravel scheduler (schedule:run every minute)
After=network.target mysql.service mariadb.service

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/mvc/api
Environment=FV_PHP_BIN=/usr/bin/php
ExecStart=/var/www/mvc/api/scripts/cron/fv-schedule-run.sh
Nice=10

[Install]
WantedBy=multi-user.target
