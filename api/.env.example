APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

# Dusk / Selenium (browser tests). Ver api/.env.dusk.example y make test-dusk.
# DUSK_DRIVER_URL=http://selenium:4444/wd/hub

# Opcional: URL pública del MVC (rutas /catalogo/producto, /company). Si no existe, se usa APP_URL.
# Definir si la API vive en otro host que el catálogo (ej. FULLVENDOR_WEB_URL=https://www.midominio.com).
# FULLVENDOR_WEB_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# Límite de intentos de login por minuto (email+IP). Antes era 5 y provocaba 429 con frecuencia.
# 0 = sin límite (solo recomendado en desarrollo).
FORTIFY_LOGIN_PER_MINUTE=300
FORTIFY_TWO_FACTOR_PER_MINUTE=60

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Opcional: mismo valor en el MVC (Docker/env). Si no se define, API y MVC usan derivación desde APP_KEY
# (en monorepo el MVC lee api/.env). Generar explícito: openssl rand -hex 32
# MVC_TOKEN_REFRESH_SECRET=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# -----------------------------------------------------------------------------
# Fotos (productos, categorías, logos, chat): MinIO vs directorio local
# -----------------------------------------------------------------------------
# IMAGES_DISK=minio          → object storage S3-compatible (producción habitual)
# IMAGES_DISK=images_local   → filesystem bajo IMAGES_LOCAL_ROOT
# Aliases de images_local: local | directory | dir
#
# Estructura en modo directorio:
#   {IMAGES_LOCAL_ROOT}/products/{companyId}/{archivo}
#   {IMAGES_LOCAL_ROOT}/categories/{companyId}/{archivo}
#   {IMAGES_LOCAL_ROOT}/chat/{companyId}/{conversationId}/{archivo}
#
IMAGES_DISK=minio
# IMAGES_LOCAL_ROOT=/var/www/mvc_uploads
# MVC_UPLOADS_PATH=/var/www/mvc_uploads
#
# Regla estricta:
#   IMAGES_DISK=images_local → lee y escribe SOLO en disco (nunca MinIO)
#   IMAGES_DISK=minio (o sin definir) → lee y escribe SOLO en MinIO
#
# Limpiar metadatos tabla images (logos, usuarios, productos, categorías):
#   php artisan images:clear-cache
#   php artisan images:clear-cache --purge-orphans
#   php artisan images:clear-cache --purge-all --delete-files
#
# Normalización al subir (JPEG calidad + scaleDown; obligatorio por defecto):
# IMAGES_STORAGE_EXTENSION=jpg
# IMAGES_STORAGE_MIME=image/jpeg
# IMAGES_STORAGE_QUALITY=82
# IMAGES_MAX_WIDTH=1200
# IMAGES_MAX_HEIGHT=1200
# IMAGES_PRODUCT_MAX_WIDTH=1200
# IMAGES_CATEGORY_MAX_WIDTH=1000
# IMAGES_COMPANY_MAX_WIDTH=800
# IMAGES_USER_MAX_WIDTH=512
# IMAGES_REQUIRE_NORMALIZATION=true


# MinIO / S3 (solo necesario si IMAGES_DISK=minio)
FILESYSTEM_CLOUD=minio
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=sail
MINIO_ROOT_PASSWORD=password
AWS_ACCESS_KEY_ID="${MINIO_ROOT_USER}"
AWS_SECRET_ACCESS_KEY="${MINIO_ROOT_PASSWORD}"
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=images
AWS_USE_PATH_STYLE_ENDPOINT=true

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Home Value / Telecom messaging API (catálogo: email, SMS, WhatsApp).
# Docs: http://telecom.birdviewmall.com/swagger/ui/index
TELECOM_API_BASE_URL=http://telecom.birdviewmall.com
TELECOM_API_KEY=
TELECOM_API_TIMEOUT=30

# Sección /api/v2/erp (header X-Api-Key)
ERP_API_KEY=f008aa014308059be6c1c20ed70a006e

# SendGrid SMTP (legacy / otros correos). El envío de catálogo usa TELECOM_* arriba.
# Remitente MAIL_FROM_ADDRESS debe estar verificado en SendGrid.
SENDGRID_API_KEY=

MAIL_MAILER=smtp
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD="${SENDGRID_API_KEY}"
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=info@fullvendor.com
MAIL_FROM_NAME="Fullvendor"

# Opcional: solo correos de prueba locales (Mailpit → http://localhost:8025), sin SendGrid
#MAIL_MAILER=smtp
#MAIL_HOST=mailpit
#MAIL_PORT=1025
#MAIL_USERNAME=null
#MAIL_PASSWORD=null
#MAIL_ENCRYPTION=null

VITE_APP_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# AI / ChatGPT / Gemini / Replicate (asistente company + media)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_CHAT_ENABLED=true
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_VIDEO_GENERATION_ENABLED=false
OPENAI_VIDEO_MODEL=sora-2
OPENAI_TTS_VOICE=onyx
OPENAI_TIMEOUT=60
OPENAI_IMAGE_GENERATION_ENABLED=true
OPENAI_IMAGE_MODEL=dall-e-3
PRODUCT_AI_IMAGE_ENABLED=true
PRODUCT_AI_IMAGE_MAX_PER_REQUEST=3
PRODUCT_AI_IMAGE_OPENVERSE_ENABLED=true

GEMINI_API_KEY=
GEMINI_IMAGE_ENHANCEMENT_ENABLED=false
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_VIDEO_GENERATION_ENABLED=false
GEMINI_VIDEO_MODEL=gemini-omni-flash-preview

REPLICATE_API_TOKEN=
