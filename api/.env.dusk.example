APP_NAME=FullVendor
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# URL del MVC vista desde la red Docker (servicio fullvendor en Sail)
APP_URL=http://fullvendor

# Hub Selenium (contenedor selenium del docker-compose)
DUSK_DRIVER_URL=http://selenium:4444/wd/hub

# Opcional: login empresa para tests Browser (UnitsImportTest)
# DUSK_COMPANY_EMAIL=
# DUSK_COMPANY_PASSWORD=

CACHE_STORE=array
SESSION_DRIVER=array
MAIL_MAILER=array
QUEUE_CONNECTION=sync
TELESCOPE_ENABLED=false
