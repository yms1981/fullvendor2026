# API Server Configuration
# Define el dominio del servidor API (sin http://)
# Ejemplo: api.tudominio.com o localhost:8000
# Docker: laravel.test (el contenedor resuelve ese host).
# Apache local: 127.0.0.1:81 y API_INTERNAL_BASE_URL para que PHP no pase por el proxy.
API_SERVER=laravel.test

# Opcional: esquema para peticiones servidor→API (proxy del logo en admin). Por defecto http (Docker).
# API_INTERNAL_SCHEME=https
# Opcional: URL base interna MVC→API (ej. http://api en Docker). Si no se define, se usa API_INTERNAL_SCHEME + API_SERVER.
# API_INTERNAL_BASE_URL=http://api
# Apache sin Docker (Laravel con PHP 8.3 en el puerto 81):
# API_SERVER=127.0.0.1:81
# API_INTERNAL_BASE_URL=http://127.0.0.1:81

# Base URL Configuration (URL pública del MVC, raíz del sitio, con https en producción)
# Correcto: https://web.fullvendor.com
# Incorrecto: https://web.fullvendor.com/admin/  (rompe CSS/JS en /backend)
# Incorrecto: http://web.fullvendor.com        (provoca Mixed Content si el sitio se sirve por HTTPS)
BASE_URL=https://web.fullvendor.com
# Con proxy TLS (nginx/traefik): 1 por defecto si existe X-Forwarded-Proto; poner 0 para desactivar
MVC_TRUST_PROXY_HTTPS=1
# El proxy DEBE enviar: proxy_set_header X-Forwarded-Proto $scheme;
