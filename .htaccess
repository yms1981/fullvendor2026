DirectoryIndex index.php
RewriteEngine On
RewriteBase /mvc/

# CORS para imágenes estáticas (Flutter Web en localhost:xxxx → 127.0.0.1)
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#/uploads/|/images/#">
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, OPTIONS"
    Header set Access-Control-Allow-Headers "Authorization, Accept, Content-Type"
  </If>
</IfModule>
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteCond %{REQUEST_URI} /uploads/|/images/
RewriteRule ^ - [R=204,L]

# API Laravel en el mismo puerto 80: /mvc/api/v2 y /mvc/api/v3
RewriteRule ^api(?:/|$) api-front.php [L,QSA]

# Estáticos de la aplicación (css, js, imágenes) sin cambiar la URL del navegador
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/mvc/mvc/$1 -f
RewriteRule ^(.*)$ mvc/$1 [L]

# Resto de rutas → controlador de CodeIgniter
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php/$1 [L]
